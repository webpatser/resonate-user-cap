{
    "name": "webpatser/resonate-user-cap",
    "description": "Per-user connection cap for Resonate: cluster-wide limit on tabs and devices per user",
    "keywords": ["resonate", "websockets", "presence", "rate-limit", "cap", "broadcasting"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Christoph Kempen",
            "email": "christoph@downsized.nl"
        }
    ],
    "require": {
        "php": "^8.6",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "webpatser/fledge-fiber": "^13.43.0.3",
        "webpatser/resonate": "^1.4"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "phpstan/phpstan": "^2.2",
        "predis/predis": "^2.2",
        "webpatser/fledge-loop": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Webpatser\\ResonateUserCap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webpatser\\ResonateUserCap\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webpatser\\ResonateUserCap\\UserCapServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "@php -d memory_limit=-1 vendor/bin/phpstan analyse",
        "lint": "pint --test",
        "test": "@php -d zend.assertions=1 -d assert.exception=1 vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
